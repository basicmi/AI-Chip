{
  "schema_version": "1.0",
  "catalog_version": "2026-11-12",
  "sources": [
    {
      "id": "nvidia-dcgm",
      "vendor": "NVIDIA",
      "collector": "Data Center GPU Manager (DCGM)",
      "documentation_url": "https://docs.nvidia.com/datacenter/dcgm/latest/dcgm-api/dcgm-api-field-ids.html",
      "status": "current",
      "version_note": "Field identifiers in the current DCGM API reference; confirm field support with the installed DCGM build and GPU generation.",
      "notes": "DCGM profiler fields include ratios and byte counters. Device fields include clocks, temperature and board power. Some byte fields are aggregate per GPU; explicit NVLink L0-L17 fields are per link."
    },
    {
      "id": "nvidia-nsight-compute",
      "vendor": "NVIDIA",
      "collector": "Nsight Compute",
      "documentation_url": "https://docs.nvidia.com/nsight-compute/ProfilingGuide/",
      "status": "current",
      "version_note": "Current online Profiling Guide; metric availability is architecture- and version-dependent.",
      "notes": "Nsight Compute metrics are queried against the installed tool and target chip. Throughput percentages are computed PerfWorks metrics, not raw byte or instruction counters. Profiling replay and collection overhead must be considered."
    },
    {
      "id": "amd-rocm-compute-profiler",
      "vendor": "AMD",
      "collector": "ROCm Compute Profiler",
      "documentation_url": "https://rocm.docs.amd.com/projects/rocprofiler-compute/en/develop/conceptual/cdna/pipeline-metrics.html",
      "status": "preview",
      "version_note": "ROCm Compute Profiler 3.11.0 develop documentation.",
      "notes": "The cited page explicitly labels its content as proposed changes for a future release. Metric names and semantics must be checked against the installed ROCm release before production use. The metrics are kernel-dispatch scoped."
    }
  ],
  "mappings": [
    {
      "id": "dcgm-fi-prof-sm-util-ratio",
      "source_id": "nvidia-dcgm",
      "source_metric": "DCGM_FI_PROF_SM_UTIL_RATIO",
      "source_field_id": 1002,
      "canonical_metric_id": "sm_active_pct",
      "source_unit": "ratio",
      "canonical_unit": "%",
      "conversion": "ratio_to_percent",
      "measurement_kind": "telemetry",
      "value_semantics": "ratio",
      "default_aggregation": "mean",
      "default_scope": "per_gpu",
      "mapping_status": "unit_converted",
      "mapping_quality": "direct",
      "notes": "Ratio of cycles with at least one warp assigned to an SM. This is not instruction issue rate or compute throughput."
    },
    {
      "id": "dcgm-fi-prof-tensor-util-ratio",
      "source_id": "nvidia-dcgm",
      "source_metric": "DCGM_FI_PROF_TENSOR_UTIL_RATIO",
      "source_field_id": 1004,
      "canonical_metric_id": "tensor_active_pct",
      "source_unit": "ratio",
      "canonical_unit": "%",
      "conversion": "ratio_to_percent",
      "measurement_kind": "telemetry",
      "value_semantics": "ratio",
      "default_aggregation": "mean",
      "default_scope": "per_gpu",
      "mapping_status": "unit_converted",
      "mapping_quality": "direct",
      "notes": "Ratio of cycles with any tensor pipe active, relative to peak sustained elapsed cycles."
    },
    {
      "id": "dcgm-fi-prof-dram-util-ratio",
