{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basicmi.github.io/AI-Chip/schemas/benchmark-results.schema.json",
  "title": "AI Chip Benchmark Results",
  "type": "object",
  "required": [
    "schema_version",
    "database_version",
    "last_reviewed",
    "scope",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "database_version": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "suite_id",
          "workload_id",
          "platform_id",
          "hardware_configuration",
          "software_stack",
          "model_configuration",
          "measurement",
          "source",
          "reproduction",
          "evidence_class",
          "measured_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "suite_id": {
            "type": "string"
          },
          "workload_id": {
            "type": "string"
          },
          "platform_id": {
            "type": "string"
          },
          "hardware_configuration": {
            "type": "object"
          },
          "software_stack": {
            "type": "object"
          },
          "model_configuration": {
            "type": "object"
          },
          "measurement": {
            "type": "object"
          },
          "source": {
            "type": "object"
          },
          "reproduction": {
            "type": "object"
          },
          "evidence_class": {
            "enum": [
              "vendor_reported",
              "upstream_ci",
              "independently_reproduced"
            ]
          },
          "measured_at": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
