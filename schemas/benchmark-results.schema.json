{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basicmi.github.io/AI-Chip/schemas/benchmark-results.schema.json",
  "title": "AI Chip Landscape Benchmark Results Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "database_version",
    "last_imported_at",
    "scope",
    "sources",
    "summary",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "database_version": {
      "type": "string",
      "minLength": 1
    },
    "last_imported_at": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "summary": {
      "type": "object"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "httpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "nullableUrl": {
      "anyOf": [
        {
          "$ref": "#/$defs/httpUrl"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name",
        "publisher",
        "source_class",
        "record_count",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "source_class": {
          "enum": [
            "standardized_public_submission",
            "third_party_public_benchmark",
            "vendor_reported",
            "independent_measurement",
            "research_evaluation"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "results_url": {
          "$ref": "#/$defs/nullableUrl"
        },
        "release_url": {
          "$ref": "#/$defs/nullableUrl"
        },
        "dataset_url": {
          "$ref": "#/$defs/nullableUrl"
        },
        "repository_url": {
          "$ref": "#/$defs/nullableUrl"
        },
        "api_url": {
          "$ref": "#/$defs/nullableUrl"
        },
        "availability_endpoint": {
          "$ref": "#/$defs/nullableUrl"
        },
        "benchmark_endpoint": {
          "$ref": "#/$defs/nullableUrl"
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "import_status": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "nodes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "host_processor_model": {
          "type": "string"
        },
        "host_processors_per_node": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "host_processor_core_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "accelerator_model": {
          "type": "string"
        },
        "accelerators_per_node": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "total_accelerators": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "platform": {
          "type": "string"
        },
        "hardware": {
          "type": "string"
        },
        "physical_prefill_gpus": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "physical_decode_gpus": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "is_multinode": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "workers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "framework": {
          "type": "string"
        },
        "operating_system": {
          "type": "string"
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "recipe_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "source_class",
        "evidence_level",
        "benchmark_suite",
        "benchmark_version",
        "publication_date",
        "submitter",
        "accelerator_vendor",
        "platform_id",
        "product_id",
        "system_type",
        "system_name",
        "division",
        "availability",
        "model",
        "scenario",
        "result_value",
        "result_unit",
        "accuracy_text",
        "inferred",
        "power_metrics_available",
        "design_power_watts",
        "system",
        "software",
        "notes",
        "compliance",
        "errors",
        "weight_data_types",
        "source_record_key",
        "source_location",
        "source_url",
        "dataset_url",
        "release_url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_class": {
          "enum": [
            "standardized_public_submission",
            "third_party_public_benchmark",
            "vendor_reported",
            "independent_measurement",
            "research_evaluation"
          ]
        },
        "evidence_level": {
          "type": "string",
          "minLength": 1
        },
        "benchmark_suite": {
          "type": "string",
          "minLength": 1
        },
        "benchmark_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "submitter": {
          "type": "string",
          "minLength": 1
        },
        "accelerator_vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "product_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "system_type": {
          "type": "string",
          "minLength": 1
        },
        "system_name": {
          "type": "string",
          "minLength": 1
        },
        "division": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "result_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "result_unit": {
          "type": "string"
        },
        "accuracy_text": {
          "type": "string"
        },
        "inferred": {
          "type": "boolean"
        },
        "power_metrics_available": {
          "type": "boolean"
        },
        "design_power_watts": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "system": {
          "$ref": "#/$defs/system"
        },
        "software": {
          "$ref": "#/$defs/software"
        },
        "workload": {
          "type": "object",
          "additionalProperties": true
        },
        "configuration": {
          "type": "object",
          "additionalProperties": true
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "notes": {
          "type": "string"
        },
        "compliance": {
          "type": "string"
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "weight_data_types": {
          "type": "string"
        },
        "source_record_key": {
          "type": "string",
          "minLength": 1
        },
        "source_location": {
          "type": "string"
        },
        "source_url": {
          "$ref": "#/$defs/nullableUrl"
        },
        "detail_url": {
          "$ref": "#/$defs/nullableUrl"
        },
        "dataset_url": {
          "$ref": "#/$defs/nullableUrl"
        },
        "release_url": {
          "$ref": "#/$defs/nullableUrl"
        },
        "model_display_name": {
          "type": "string",
          "minLength": 1
        },
        "power_measurement_valid": {
          "type": "boolean"
        },
        "normalized_metrics": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/normalizedMetric"
          }
        },
        "cpu_power_measurement_valid": {
          "type": "boolean"
        },
        "gpu_power_metrics_available": {
          "type": "boolean"
        },
        "cpu_power_metrics_available": {
          "type": "boolean"
        },
        "power_measurement_status": {
          "enum": [
            "valid",
            "failed",
            "schema_incomplete",
            "unreported",
            "invalid_verdict"
          ]
        },
        "cpu_power_measurement_status": {
          "enum": [
            "valid",
            "failed",
            "not_present",
            "invalid_verdict"
          ]
        },
        "hardware_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/hardwareEvidence"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "normalizedMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "direction",
        "label",
        "source_metric",
        "family"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "higher",
            "lower",
            "context"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "source_metric": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "enum": [
            "interactivity",
            "throughput",
            "latency",
            "energy",
            "power",
            "cpu_energy",
            "cpu_power",
            "telemetry"
          ]
        }
      }
    },
    "hardwareEvidenceMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "value",
        "unit",
        "measurement_kind",
        "aggregation",
        "scope",
        "source_name"
      ],
      "properties": {
        "metric_id": {
          "enum": [
            "sm_active_pct",
            "tensor_active_pct",
            "compute_flop_count",
            "achieved_flops",
            "theoretical_peak_flops",
            "dram_read_bytes",
            "dram_write_bytes",
            "dram_bandwidth_bytes_per_s",
            "dram_peak_bandwidth_bytes_per_s",
            "hbm_used_bytes",
            "hbm_capacity_bytes",
            "kv_cache_used_bytes",
            "kv_cache_capacity_bytes",
            "kv_cache_tokens",
            "kv_cache_token_capacity",
            "kv_cache_hit_rate_pct",
            "nvlink_tx_bytes",
            "nvlink_rx_bytes",
            "pcie_tx_bytes",
            "pcie_rx_bytes",
            "network_tx_bytes",
            "network_rx_bytes",
            "link_bandwidth_bytes_per_s",
            "link_peak_bandwidth_bytes_per_s",
            "link_utilization_pct",
            "gpu_power_w",
            "gpu_clock_hz",
            "memory_clock_hz",
            "temperature_c",
            "throttle_active_pct"
          ]
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "%",
            "FLOP/s",
            "byte",
            "byte/s",
            "token",
            "W",
            "Hz",
            "°C",
            "FLOP"
          ]
        },
        "measurement_kind": {
          "enum": [
            "hardware_counter",
            "telemetry",
            "derived"
          ]
        },
        "aggregation": {
          "enum": [
            "instantaneous",
            "mean",
            "max",
            "min",
            "p50",
            "p95",
            "p99",
            "sum",
            "rate"
          ]
        },
        "scope": {
          "enum": [
            "per_gpu",
            "per_link",
            "per_node",
            "per_system",
            "per_process"
          ]
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "link_type": {
          "enum": [
            "nvlink",
            "pcie",
            "infiniband",
            "roce",
            "ethernet",
            "other"
          ]
        },
        "formula": {
          "type": "string",
          "minLength": 1
        },
        "input_metric_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "sm_active_pct",
              "tensor_active_pct",
              "compute_flop_count",
              "achieved_flops",
              "theoretical_peak_flops",
              "dram_read_bytes",
              "dram_write_bytes",
              "dram_bandwidth_bytes_per_s",
              "dram_peak_bandwidth_bytes_per_s",
              "hbm_used_bytes",
              "hbm_capacity_bytes",
              "kv_cache_used_bytes",
              "kv_cache_capacity_bytes",
              "kv_cache_tokens",
              "kv_cache_token_capacity",
              "kv_cache_hit_rate_pct",
              "nvlink_tx_bytes",
              "nvlink_rx_bytes",
              "pcie_tx_bytes",
              "pcie_rx_bytes",
              "network_tx_bytes",
              "network_rx_bytes",
              "link_bandwidth_bytes_per_s",
              "link_peak_bandwidth_bytes_per_s",
              "link_utilization_pct",
              "gpu_power_w",
              "gpu_clock_hz",
              "memory_clock_hz",
              "temperature_c",
              "throttle_active_pct"
            ]
          }
        },
        "precision": {
          "type": "string",
          "minLength": 1
        },
        "sparsity": {
          "enum": [
            "dense",
            "structured_sparse",
            "unstructured_sparse",
            "unknown"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "measurement_kind": {
                "const": "derived"
              }
            },
            "required": [
              "measurement_kind"
            ]
          },
          "then": {
            "required": [
              "formula",
              "input_metric_ids"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "measurement_kind": {
                "enum": [
                  "hardware_counter",
                  "telemetry"
                ]
              }
            },
            "required": [
              "measurement_kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "formula"
                  ]
                },
                {
                  "required": [
                    "input_metric_ids"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric_id": {
                "enum": [
                  "achieved_flops",
                  "theoretical_peak_flops"
                ]
              }
            },
            "required": [
              "metric_id"
            ]
          },
          "then": {
            "required": [
              "precision",
              "sparsity"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "metric_id": {
                "enum": [
                  "sm_active_pct",
                  "tensor_active_pct",
                  "kv_cache_hit_rate_pct",
                  "link_utilization_pct",
                  "throttle_active_pct"
                ]
              }
            },
            "required": [
              "metric_id"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "maximum": 100
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric_id": {
                "enum": [
                  "link_bandwidth_bytes_per_s",
                  "link_peak_bandwidth_bytes_per_s",
                  "link_utilization_pct",
                  "network_tx_bytes",
                  "network_rx_bytes"
                ]
              }
            },
            "required": [
              "metric_id"
            ]
          },
          "then": {
            "required": [
              "link_type"
            ]
          }
        }
      ]
    },
    "hardwareEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "collector",
        "system_scope",
        "sampling",
        "provenance",
        "metrics"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "collector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "type"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "enum": [
                "profiler",
                "device_telemetry",
                "runtime_telemetry",
                "network_telemetry",
                "publisher_export",
                "other"
              ]
            }
          }
        },
        "system_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope_type",
            "device_count"
          ],
          "properties": {
            "scope_type": {
              "enum": [
                "per_gpu",
                "per_link",
                "per_node",
                "per_system",
                "per_process"
              ]
            },
            "device_count": {
              "type": "integer",
              "minimum": 1
            },
            "device_model": {
              "type": "string"
            },
            "topology": {
              "type": "string"
            }
          }
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "started_at",
            "ended_at",
            "sample_interval_ms",
            "sample_count"
          ],
          "properties": {
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "ended_at": {
              "type": "string",
              "format": "date-time"
            },
            "sample_interval_ms": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "sample_count": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_type",
            "source_url",
            "collected_at"
          ],
          "properties": {
            "source_type": {
              "enum": [
                "publisher_api",
                "profiler_export",
                "telemetry_export",
                "independent_measurement",
                "vendor_report",
                "other"
              ]
            },
            "source_url": {
              "$ref": "#/$defs/httpUrl"
            },
            "collected_at": {
              "type": "string",
              "format": "date-time"
            },
            "artifact_sha256": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hardwareEvidenceMetric"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
