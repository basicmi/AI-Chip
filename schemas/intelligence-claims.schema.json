{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://basicmi.github.io/AI-Chip/schemas/intelligence-claims.schema.json",
 "title":"AI Chip Intelligence Extracted Claim Candidates","type":"object","additionalProperties":false,
 "required":["schema_version","generated_at","input_candidate_count","claim_count","extraction_method","claims","errors","policy"],
 "properties":{
  "schema_version":{"const":"1.0"},"generated_at":{"type":"string","format":"date-time"},
  "input_candidate_count":{"type":"integer","minimum":0},"claim_count":{"type":"integer","minimum":0},
  "extraction_method":{"const":"deterministic_rules_v1"},"claims":{"type":"array","items":{"$ref":"#/$defs/claim"}},
  "errors":{"type":"array"},"policy":{"type":"string","minLength":1}},
 "$defs":{"claim":{"type":"object","additionalProperties":false,
  "required":["claim_id","candidate_id","claim_type","topic","statement","value","unit","scope","qualifiers","source","evidence_quote","extraction","review_status","review_gates"],
  "properties":{
   "claim_id":{"type":"string","pattern":"^claim-[a-f0-9]{20}$"},"candidate_id":{"type":"string","minLength":1},
   "claim_type":{"enum":["performance_result","availability_or_lifecycle","research_finding","software_or_capability","quantitative_specification","qualitative_capability"]},
   "topic":{"enum":["memory_bandwidth","memory_capacity","interconnect","power","compute","process_node","packaging","software_support","availability","performance","architecture","other"]},
   "statement":{"type":"string","minLength":1,"maxLength":1200},"value":{"type":["number","null"]},"unit":{"type":["string","null"]},
   "scope":{"type":"object","additionalProperties":false,"required":["status","text"],"properties":{
    "status":{"enum":["explicit_per_unit","explicit_level","explicit_aggregate","not_explicitly_stated"]},"text":{"type":["string","null"]}}},
   "qualifiers":{"type":"array","items":{"type":"string"}},
   "source":{"type":"object","additionalProperties":false,
    "required":["candidate_id","source_id","source_name","publisher","source_type","independence","url","published_at","evidence_scope"],
    "properties":{"candidate_id":{"type":["string","null"]},"source_id":{"type":["string","null"]},
     "source_name":{"type":["string","null"]},"publisher":{"type":["string","null"]},"source_type":{"type":"string"},
     "independence":{"type":"string"},"url":{"type":"string","format":"uri"},
     "published_at":{"type":["string","null"]},"evidence_scope":{"type":"string"}}},
   "evidence_quote":{"type":"string","minLength":1},
   "extraction":{"type":"object","additionalProperties":false,"required":["method","confidence","matched_signals","requires_semantic_review"],
    "properties":{"method":{"const":"deterministic_rules_v1"},"confidence":{"enum":["low","medium"]},
     "matched_signals":{"type":"array","items":{"type":"string"}},"requires_semantic_review":{"const":true}}},
   "review_status":{"const":"unverified_candidate"},"review_gates":{"type":"array","minItems":1,"items":{"type":"string"}}}}}
}
