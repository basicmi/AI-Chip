{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basicmi.github.io/AI-Chip/schemas/company-profiles.schema.json",
  "title": "AI Chip Company Profile and Evidence Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "database_version",
    "registry_reviewed_at",
    "scope",
    "freshness_policy",
    "profile_status_definitions",
    "companies",
    "comparison_policy"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.2"
    },
    "database_version": {
      "type": "string",
      "minLength": 1
    },
    "registry_reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "freshness_policy": {
      "$ref": "#/$defs/freshness_policy"
    },
    "profile_status_definitions": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "companies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/company"
      }
    },
    "comparison_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precision_must_match",
        "sparsity_must_match",
        "measurement_scope_must_match",
        "metric_type_must_match",
        "system_and_chip_metrics_must_not_be_mixed",
        "source_units_must_be_preserved",
        "notes"
      ],
      "properties": {
        "precision_must_match": {
          "type": "boolean"
        },
        "sparsity_must_match": {
          "type": "boolean"
        },
        "measurement_scope_must_match": {
          "type": "boolean"
        },
        "metric_type_must_match": {
          "type": "boolean"
        },
        "system_and_chip_metrics_must_not_be_mixed": {
          "type": "boolean"
        },
        "source_units_must_be_preserved": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nullable_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "freshness_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_within_days",
        "stale_after_days",
        "missing_checked_at_means",
        "notes"
      ],
      "properties": {
        "fresh_within_days": {
          "type": "integer",
          "minimum": 1
        },
        "stale_after_days": {
          "type": "integer",
          "minimum": 2
        },
        "missing_checked_at_means": {
          "type": "string",
          "const": "unreviewed"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "url",
        "source_type",
        "review_status",
        "published_at",
        "checked_at",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "unknown",
            "company_primary",
            "vendor_primary",
            "official_project",
            "research_paper",
            "independent_media",
            "repository",
            "government_or_regulatory",
            "other"
          ]
        },
        "review_status": {
          "type": "string",
          "enum": [
            "unreviewed",
            "reviewed",
            "excluded"
          ]
        },
        "published_at": {
          "$ref": "#/$defs/nullable_date"
        },
        "checked_at": {
          "$ref": "#/$defs/nullable_date"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url",
        "publisher",
        "source_type",
        "independence",
        "published_at",
        "checked_at",
        "review_status",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "enum": [
            "company_primary",
            "vendor_primary",
            "official_project",
            "research_paper",
            "independent_media",
            "government_or_regulatory",
            "repository",
            "other"
          ]
        },
        "independence": {
          "type": "string",
          "enum": [
            "vendor",
            "project",
            "independent",
            "official"
          ]
        },
        "published_at": {
          "$ref": "#/$defs/nullable_date"
        },
        "checked_at": {
          "type": "string",
          "format": "date"
        },
        "review_status": {
          "type": "string",
          "enum": [
            "reviewed",
            "disputed"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "product_type",
        "availability",
        "claim_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "product_type": {
          "type": "string",
          "enum": [
            "gpu",
            "npu",
            "asic",
            "dpu",
            "ip",
            "system",
            "compute_in_memory",
            "other"
          ]
        },
        "architecture": {
          "type": "string"
        },
        "generation": {
          "type": "string"
        },
        "process_node": {
          "type": "string"
        },
        "market_segment": {
          "type": "string"
        },
        "availability": {
          "type": "string",
          "enum": [
            "announced",
            "sampling",
            "shipping",
            "production",
            "roadmap",
            "discontinued",
            "unknown"
          ]
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "form_factor": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "system_configuration": {
          "type": "string",
          "minLength": 1
        },
        "die_count": {
          "type": "integer",
          "minimum": 1
        },
        "announced_at": {
          "$ref": "#/$defs/nullable_date"
        },
        "first_available_at": {
          "$ref": "#/$defs/nullable_date"
        },
        "related_product_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "compatibility_platform_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "availability_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/availability_history_item"
          },
          "description": "Dated, source-linked product lifecycle events in chronological order. The latest event status must equal availability."
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_type",
        "subject_id",
        "topic",
        "statement",
        "scope",
        "claim_status",
        "evidence_ids",
        "last_reviewed"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "subject_type": {
          "type": "string",
          "enum": [
            "company",
            "product"
          ]
        },
        "subject_id": {
          "$ref": "#/$defs/id"
        },
        "topic": {
          "type": "string",
          "enum": [
            "product_identity",
            "architecture",
            "process_node",
            "compute",
            "memory_capacity",
            "memory_bandwidth",
            "interconnect",
            "power",
            "software_support",
            "availability",
            "deployment",
            "performance",
            "other",
            "memory_type",
            "packaging",
            "die_count",
            "form_factor",
            "system_scale",
            "networking",
            "thermal"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "unit": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "claim_status": {
          "type": "string",
          "enum": [
            "vendor_reported",
            "source_confirmed",
            "independently_verified",
            "disputed",
            "superseded"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "last_reviewed": {
          "type": "string",
          "format": "date"
        },
        "valid_until": {
          "$ref": "#/$defs/nullable_date"
        },
        "notes": {
          "type": "string"
        },
        "metric_context": {
          "$ref": "#/$defs/metric_context"
        }
      }
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "category",
        "directory_anchor",
        "logo_url",
        "summary",
        "profile_status",
        "last_reviewed",
        "products",
        "claims",
        "evidence",
        "references"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "IC Vendors",
            "Tech Giants & HPC Vendors",
            "Traditional IP Vendors",
            "Startups",
            "China AI Accelerator Vendors"
          ]
        },
        "directory_anchor": {
          "type": "string",
          "minLength": 1
        },
        "logo_url": {
          "$ref": "#/$defs/url"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "profile_status": {
          "type": "string",
          "enum": [
            "not_reviewed",
            "partially_reviewed",
            "reviewed"
          ]
        },
        "last_reviewed": {
          "$ref": "#/$defs/nullable_date"
        },
        "products": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/product"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "metric_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_type",
        "measurement_scope",
        "operation"
      ],
      "properties": {
        "metric_type": {
          "type": "string",
          "enum": [
            "specification",
            "theoretical_peak",
            "vendor_measured",
            "independent_measured",
            "production_observed",
            "derived"
          ]
        },
        "precision": {
          "type": "string",
          "enum": [
            "FP64",
            "FP32",
            "TF32",
            "BF16",
            "FP16",
            "FP8",
            "FP6",
            "FP4",
            "MXFP8",
            "MXFP6",
            "MXFP4",
            "NVFP4",
            "INT8",
            "INT4",
            "INT2",
            "mixed",
            "not_applicable",
            "unspecified"
          ]
        },
        "sparsity": {
          "type": "string",
          "enum": [
            "dense",
            "structured_sparse",
            "unstructured_sparse",
            "not_applicable",
            "unspecified"
          ]
        },
        "operation": {
          "type": "string",
          "enum": [
            "matrix",
            "vector",
            "scalar",
            "memory",
            "interconnect",
            "communication",
            "power",
            "area",
            "system_configuration",
            "other"
          ]
        },
        "measurement_scope": {
          "type": "string",
          "enum": [
            "die",
            "chip",
            "package",
            "module",
            "board",
            "server",
            "rack",
            "pod",
            "cluster",
            "system"
          ]
        },
        "directionality": {
          "type": "string",
          "enum": [
            "unidirectional",
            "bidirectional",
            "aggregate",
            "not_applicable",
            "unspecified"
          ]
        },
        "configuration": {
          "type": "string",
          "minLength": 1
        },
        "workload_id": {
          "$ref": "#/$defs/id"
        },
        "benchmark_project_id": {
          "$ref": "#/$defs/id"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "availability_history_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "effective_at",
        "evidence_id",
        "notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "announced",
            "sampling",
            "shipping",
            "production",
            "roadmap",
            "discontinued",
            "unknown"
          ]
        },
        "effective_at": {
          "$ref": "#/$defs/nullable_date"
        },
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
